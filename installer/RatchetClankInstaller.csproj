<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Instalar-Ratchet-Clank</AssemblyName>
    <ApplicationIcon>RatchetAndClank.ico</ApplicationIcon>
    <Product>Ratchet &amp; Clank Recomp</Product>
    <FileDescription>Instalador de Ratchet &amp; Clank Recomp</FileDescription>
    <Version>1.1.0</Version>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="payload/GameBundle.zip" LogicalName="GameBundle.zip" />
    <EmbeddedResource Include="../assets/logo-transparente.png" LogicalName="InstallerLogo.png" />
  </ItemGroup>
</Project>
